
APP_ENV=development
HTTP_PORT=8080

# Postgres — must match docker-compose.yml's postgres service
POSTGRES_USER=retrievion
POSTGRES_PASSWORD=retrievion
POSTGRES_DB=retrievion
MAX_IDLE_CONNS=10
MAX_OPEN_CONNS=50
MIGRATION_PATH=migrations
JWT_EXPIRATION_HOURS=72


# RabbitMQ (Phase 4+)
RABBITMQ_USER=retrievion
RABBITMQ_PASSWORD=retrievion
# RABBITMQ_URL=amqp://retrievion:retrievion@localhost:5672/

# LLM / Embedding providers (Phase 4/6+) — from your own Topic 2/7 work
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
MAX_TOKENS=1024
TEMPERATURE=0.7
MAX_CONTEXT_TOKENS=8000


EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
GENERATEURL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
STREAMURL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:streamGenerateContent

RERANKER_PROVIDER=
RERANKER_API_KEY=

JWT_SECRET=change-me-to-a-real-random-secret

# Observability (Phase 10, profile: observability)
OTEL_ENDPOINT=http://localhost:4317
GRAFANA_ADMIN_PASSWORD=admin


B2_BUCKET=rentivox-storage
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_SIGNED_URL_EXPIRY=10m


GEMINI_API_KEY=
PROJECT_NAME=projects/
PROJECT_NUMBER=
LLM_INPUT_PRICE_PER_MILLION=0.30
LLM_OUTPUT_PRICE_PER_MILLION=2.50


GOOGLE_OAUTH_CLIENTID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALL_BACK_API=http://localhost:8081/auth/google/callback
GOOGLE_USERINFO_API=https://www.googleapis.com/oauth2/v2/userinfo


# SMPT CONFIGUTATIONS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=


PRIVATE_KEY=
PUBLIC_KEY=


#use the following when running application with docker
DATABASE_URL=postgres://retrievion:retrievion@postgres:5432/retrievion?sslmode=disable
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://retrievion:retrievion@rabbitmq:5672/


# use following when running without docker 
# DATABASE_URL=postgres://retrievion:retrievion@localhost:5436/retrievion?sslmode=disable
# RABBITMQ_URL=amqp://retrievion:retrievion@localhost:5672/
